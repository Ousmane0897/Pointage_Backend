# Modèle des variables d'environnement — copier en .env (non suivi par git) et renseigner.
# Ne JAMAIS commiter de valeur réelle, ni dans ce fichier ni ailleurs.
#
# Utilisé par :
#   - Spring Boot en développement (spring.config.import: optional:file:.env[.properties]) ;
#   - docker-compose en production (env_file: .env).

# Clé de signature des JWT (HS256) — 32 caractères minimum, aléatoire.
JWT_SECRET=

# Compte SMTP d'envoi des e-mails (mot de passe d'application du fournisseur).
MAIL_USERNAME=
MAIL_PASSWORD=

# Clé Google Maps (géocodage) — restreinte par IP/API dans la console Google Cloud.
GOOGLE_MAPS_API_KEY=

# Mot de passe initial du super-administrateur, utilisé UNE SEULE FOIS si le compte n'existe
# pas encore (mustChangePassword=true). Laisser vide : aucun compte n'est créé.
SUPERADMIN_INITIAL_PASSWORD=

# URL publique du front (liens des e-mails). Facultatif.
APP_FRONTEND_BASE_URL=
